



generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  fullName    String
  area        String
  role        String
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model EmailVerification {
  id        String   @id @default(uuid())
  code      String
  email     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}







