# SQL Server. Keep MSSQL_SA_PASSWORD in sync with the password in DATABASE_URL.
# For production, use a trusted TLS certificate and set trustServerCertificate=false.
MSSQL_SA_PASSWORD=replace-with-a-strong-password
DATABASE_URL="sqlserver://localhost:1433;database=TransforMC;user=sa;password=replace-with-a-strong-password;encrypt=true;trustServerCertificate=true"

# Application
PORT=3000
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=86400

# Microsoft Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:3000/auth/azure-callback

# Required for the survey feedback queue and rate limiting
REDIS_URL=redis://localhost:6379

# Optional AI feedback
GROQ_API_KEY=
# Optional, ordered comma-separated model fallbacks
GROQ_FEEDBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b,openai/gpt-oss-120b

# Optional admin chat
GROQ_CHAT_API_KEY=
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# Optional realtime notifications
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
